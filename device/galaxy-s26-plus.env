# Perfil de build do Galaxy S26+ (kernel 6.12).
#
# Estes valores alimentam scripts/build-lkm.sh e o workflow do GitHub Actions.
# A variável KERNEL_RELEASE é OBRIGATÓRIA e precisa ser a string EXATA de
# `uname -r` do aparelho — é ela que vira o `vermagic` do módulo. Se não bater,
# o kernel Samsung (CONFIG_MODULE_FORCE_LOAD=n) recusa o carregamento do .ko.

# String exata de `uname -r` do S26+ (inclua todo o sufixo de build).
# Fornecido pelo usuário: "6.12.38-android16-5-p8aa82f3-abogkiS947BXXS4AZHA-4k22:53"
# O sufixo "22:53" foi removido por parecer um resquício de timestamp/terminal
# (release de kernel não costuma conter ':'). CONFIRME com `adb shell uname -r`
# ou `cat /proc/version` e ajuste se necessário — precisa bater 100%.
KERNEL_RELEASE="6.12.38-android16-5-p8aa82f3-abogkiS947BXXS4AZHA-4k"

# KMI derivado do release (androidNN-<major.minor>). Para o S26+ (Android 16 /
# kernel 6.12) normalmente é android16-6.12. Confirme com o seu `uname -r`.
KMI="android16-6.12"

# Base do KernelSU: fork polygraphene, branch kdp-612, commit fixado.
KSU_REPO="https://github.com/polygraphene/KernelSU"
KSU_COMMIT="a5531763971cf034e3f630d31654189a148e5f81"

# Release da imagem DDK usada para compilar o módulo (tag ghcr.io/ylarod/ddk-min).
DDK_RELEASE="20260313"

# Configs do KernelSU para o caminho Samsung (KDP/RKP/DEFEX).
KSU_CONFIGS="CONFIG_KSU=m CONFIG_KSU_SAMSUNG_KDP=y CONFIG_KSU_SAMSUNG_RKP=y CONFIG_KSU_SAMSUNG_DEFEX=y"

# NDK usado para o ksud (mantido igual ao CI oficial do KernelSU).
NDK_VERSION="r29"
ANDROID_API="26"
